# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon key, or the newer publishable key (sb_publishable_...). Safe to expose: RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Photo analysis provider: "anthropic" (default) or "gemini".
AI_PROVIDER=anthropic

# Anthropic (server-only). Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Gemini via AI Studio (server-only), used when AI_PROVIDER=gemini.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
